{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    ["@semantic-release/exec", {
      "prepareCmd": "sed -i.bak \"s/^#define FW_VERSION .*/#define FW_VERSION \\\"${nextRelease.version}\\\"/\" include/version.h && rm -f include/version.h.bak && pio run -e esp32-s3-epaper154"
    }],
    ["@semantic-release/git", {
      "assets": ["CHANGELOG.md", "include/version.h", "package.json"],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", {
      "assets": [
        { "path": ".pio/build/esp32-s3-epaper154/firmware.bin", "label": "firmware.bin" }
      ]
    }]
  ]
}
